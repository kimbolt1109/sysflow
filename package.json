{
  "name": "flow-ai-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Flow — unified multi-model, multi-agent AI coding CLI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "coding",
    "cli",
    "agents",
    "llm"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "flow": "dist/index.js"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "tsx src/index.ts --help",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tsc-alias": "^1",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
