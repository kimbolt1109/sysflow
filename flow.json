{
  "$comment": "Flow model registry, routing table, and quota defaults. Prices in USD per 1M tokens (estimates, verify against providers).",
  "models": [
    {
      "id": "anthropic/claude-sonnet",
      "provider": "anthropic",
      "label": "Claude Sonnet",
      "contextWindow": 200000,
      "inputPricePerM": 3,
      "outputPricePerM": 15,
      "tags": ["recommended"]
    },
    {
      "id": "anthropic/claude-opus",
      "provider": "anthropic",
      "label": "Claude Opus",
      "contextWindow": 200000,
