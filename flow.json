      "outputPricePerM": 10,
      "tags": ["recommended", "big-context"]
    },
    {
      "id": "openai/gpt-5-mini",
      "provider": "openai",
      "label": "GPT 5 Mini",
      "contextWindow": 400000,
      "inputPricePerM": 0.5,
      "outputPricePerM": 2,
      "tags": ["fast", "cheap"]
    },
    {
      "id": "google/gemini-pro",
      "provider": "google",
