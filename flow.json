  "routing": [
    {
      "match": "anthropic/*",
      "driver": "cli",
      "command": "claude",
      "args": ["--dangerously-skip-permissions"]
    },
    {
      "match": "openai/gpt-oss-*",
      "driver": "cli",
      "command": "agy",
      "args": ["--dangerously-skip-permissions"]
    },
    { "match": "openai/gpt-*", "driver": "cli", "command": "codex" },
    {
      "match": "google/gemini-*",
      "driver": "cli",
      "command": "agy",
      "args": ["--dangerously-skip-permissions"]
    },
    { "match": "grok/*", "driver": "cli", "command": "grok", "args": ["--always-approve"] },
    { "match": "*", "driver": "cli", "command": "opencode" }
  ],
  "quotas": {
    "warnAt": 0.7,
    "amberAt": 0.85,
    "confirmAt": 0.95
  }
}
