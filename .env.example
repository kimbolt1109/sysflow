# Minimum log level: debug | info | warn | error
APP_LOG_LEVEL=info
# Where Flow keeps settings and JSONL sessions (default ~/.flow)
# APP_DATA_DIR=
# Model registry + routing table (default ./flow.json)
# APP_FLOW_JSON=
# Default model id (default: first entry in flow.json)
# APP_MODEL=
# Provider keys — no defaults; missing keys fall back to mock/CLI drivers, never plaintext in logs
# APP_ANTHROPIC_API_KEY=
# APP_OPENAI_API_KEY=
# APP_GOOGLE_API_KEY=
# APP_OPENROUTER_API_KEY=
# Cost guards in USD, 0 = unlimited
APP_DAILY_BUDGET=0
APP_MAX_COST=0
# Auto-compact threshold as a fraction of context window (0.5–0.95)
APP_COMPACT_THRESHOLD=0.85
